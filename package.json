{
  "name": "termtrove",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --include \"app/**/*\" --include \"public/**/*\" --include \"index.html\" --include \"scripts/build-client.mjs\" server/dev.ts",
    "build": "node scripts/build-client.mjs && node scripts/seo.mjs",
    "start": "tsx server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:start": "npx supabase@2.75.0 start",
    "db:reset": "npx supabase@2.75.0 db reset",
    "db:stop": "npx supabase@2.75.0 stop",
    "build:preview": "node scripts/build-preview.mjs",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.0",
    "cookie": "^1.0.2",
    "dotenv": "^16.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2"
  }
}
