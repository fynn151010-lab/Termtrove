# Supabase project Settings → API. The publishable/anon key is not a service-role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
# Absolute public application origin, no trailing slash.
APP_ORIGIN=http://localhost:5173
PORT=5173
# Never add a service-role key to this application: row-level security must remain active.
# Render sets RENDER_EXTERNAL_URL automatically; it is used if APP_ORIGIN is omitted.
